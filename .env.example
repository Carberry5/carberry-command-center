# Copy to .env and fill in. Nothing here is a secret — only paths and
# 1Password *references*. The secrets themselves stay in 1Password.

# --- Obsidian vault -------------------------------------------------------
# Root of the vault. The app owns one folder inside it (VAULT_FOLDER).
VAULT_PATH=~/Documents/Obsidian/Carberry
VAULT_FOLDER=Family Council

# Port the sidecar listens on. The Vite dev server proxies /api and /events here.
PORT=8787

# --- 1Password ------------------------------------------------------------
# Requires the `op` CLI on PATH and a signed-in session (`op signin`).
# Values are read on demand and never written to disk or the vault.

# Sidekick + Savings — the Claude API key that turns pasted school emails into
# events, and store ads into matched grocery deals.
# Either point at 1Password:
OP_ANTHROPIC_REF=op://Family/Anthropic API/credential
# …or set the key directly instead (OP_ANTHROPIC_REF wins if both are set):
# ANTHROPIC_API_KEY=sk-ant-...

# Wearable / banking tokens. The Connect buttons report whether these resolve;
# none of these vendors offers a browser-usable sync yet, so the cards stay on
# hand-entered numbers until they do.
OP_WHOOP_REF=op://Family/WHOOP/api token
OP_OURA_REF=op://Family/Oura/personal access token
OP_GREENLIGHT_REF=op://Family/Greenlight/api token

# --- Supabase (cloud branch) ----------------------------------------------
#
# Copy this file to .env.local and fill in the blanks. .env.local is gitignored,
# and every script in scripts/ reads it automatically — so these values are
# typed once and never again. A real environment variable always wins, so CI
# (which injects secrets directly and has no .env.local) is unaffected.
#
# Never paste the contents of .env.local into a chat window, an issue, or a
# commit.
#
# Project ref rdmlrmilkgalixiafbfg. The two VITE_ values are safe in the client
# bundle: the publishable key only grants what RLS in supabase/schema.sql
# allows, which is "rows belonging to the household this session is linked to"
# and nothing else.
VITE_SUPABASE_URL=https://rdmlrmilkgalixiafbfg.supabase.co
VITE_SUPABASE_ANON_KEY=

# The scripts use these two names rather than the VITE_ ones.
SUPABASE_URL=https://rdmlrmilkgalixiafbfg.supabase.co

# Project Settings -> API Keys -> *Secret keys*. Starts sb_secret_, or the
# legacy service_role JWT starting eyJhbGci. You have to click Reveal to see it,
# which is the tell that you have the right one.
#
# NOT the sb_publishable_ key. That one is public by design and cannot bypass
# RLS, so every write from a script would fail.
#
# This key bypasses RLS entirely — treat it like a root password. It is what
# reads oauth_tokens and what would enforce parent-only actions that the PIN
# merely hints at in the UI. It must never carry a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Tasks ---------------------------------------------------------
# console.cloud.google.com -> Google Auth Platform -> Clients -> carberry-cli.
# The client id is not secret; the secret is. See docs/google-tasks.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- WHOOP OAuth ----------------------------------------------------------
# Only needed to connect or refresh Patrick's WHOOP.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8910/

# Postgres connection used by `npm run test:cloud`. Defaults to a local
# throwaway cluster; see scripts/cloud-test.sh for how to create one.
# PGURL=postgres://postgres@127.0.0.1:55432/cctest
