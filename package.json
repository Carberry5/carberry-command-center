{
  "name": "carberry-command-center",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Family Council / Carberry Command Center — family dashboard for iPad, TV and desktop, mirrored to an Obsidian vault with secrets in 1Password.",
  "scripts": {
    "dev": "concurrently -n sidecar,web -c magenta,cyan \"npm:dev:sidecar\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:sidecar": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node --import tsx server/index.ts --serve-static",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "test:cloud": "bash scripts/cloud-test.sh",
    "test:seed": "tsx scripts/seed-test.ts",
    "test:gtasks": "tsx scripts/gtasks-test.ts",
    "test:winddown": "tsx scripts/winddown-test.ts",
    "test:launches": "tsx scripts/launches-test.ts",
    "test:upcoming": "tsx scripts/upcoming-test.ts",
    "test:photo": "tsx scripts/photo-test.ts",
    "test:feedmatch": "tsx scripts/feedmatch-test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@supabase/supabase-js": "^2.111.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "pg": "^8.22.0",
    "playwright": "^1.62.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
